# NavBuddy Environment Variables

# ── Required for navbuddy setup (Street View frame download) ──
# Enable these APIs: Street View Static API, Directions API, Geocoding API
# Get a key at: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=

# ── Required for navbuddy evaluate (VLM inference via OpenRouter) ──
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Optional: for gated models (Gemma, Llama, etc.) ──
# Get a token at: https://huggingface.co/settings/tokens
HF_TOKEN=

# ── Optional: caches inference results to avoid re-running expensive API calls ──
# Get credentials at: https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Optional: vector store for instruction embeddings (ICL example retrieval) ──
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
